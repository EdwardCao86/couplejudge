<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CatCoupleJudge" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pink_primary</item>
        <item name="colorSecondary">@color/pink_secondary</item>
        <item name="android:statusBarColor">@color/pink_surface</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/pink_surface</item>
        <item name="materialButtonStyle">@style/Widget.CatCoupleJudge.Button</item>
        <item name="android:buttonStyle">@style/Widget.CatCoupleJudge.Button.Base</item>
    </style>

    <style name="Widget.CatCoupleJudge.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.CatCoupleJudge.Button.Base" parent="@android:style/Widget.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Widget.CatCoupleJudge.Button.Primary" parent="@style/Widget.CatCoupleJudge.Button.Base">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/button_text_primary</item>
    </style>

    <style name="Widget.CatCoupleJudge.Button.Secondary" parent="@style/Widget.CatCoupleJudge.Button.Base">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/button_text_secondary</item>
    </style>
</resources>
